{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口、起居注悬浮窗与桌宠云绾的权限（文件操作全部经 Rust 命令完成，前端仅授予核心与窗口关闭/拖动权限）",
  "windows": ["main", "qijuzhu", "pet"],
  "permissions": ["core:default", "core:window:allow-close", "core:window:allow-start-dragging", "core:window:allow-set-size", "core:window:allow-set-position", "core:window:allow-outer-size", "core:window:allow-outer-position"]
}
